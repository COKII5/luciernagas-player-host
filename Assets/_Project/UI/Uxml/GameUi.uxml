<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="MainMenu" src="MainMenu.uxml" />
    <ui:Template name="Lobby" src="Lobby.uxml" />
    <ui:Template name="Hud" src="Hud.uxml" />
    <ui:Template name="Results" src="Results.uxml" />
    <ui:Template name="AdminPanel" src="AdminPanel.uxml" />
    <ui:Template name="Overlays" src="Overlays.uxml" />
    <ui:VisualElement name="ui-root" class="ui-root" picking-mode="Ignore">
        <ui:VisualElement name="world-labels" class="layer" picking-mode="Ignore" />
        <ui:Instance template="Hud" picking-mode="Ignore" />
        <ui:Instance template="Lobby" picking-mode="Ignore" />
        <ui:Instance template="Results" picking-mode="Ignore" />
        <ui:Instance template="MainMenu" picking-mode="Ignore" />
        <ui:Instance template="AdminPanel" picking-mode="Ignore" />
        <ui:Instance template="Overlays" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
